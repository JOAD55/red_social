RewriteEngine On

RewriteRule ^usuario/correo$ /red_social/BACK/rutas/rutas.php [L]
RewriteRule ^usuario/correo/([0-9]+)$ /red_social/BACK/rutas/rutas.php?id=$1 [L,QSA]

RewriteRule ^usuario$ /red_social/BACK/rutas/rutas.php [L]
RewriteRule ^usuario/([0-9]+)$ /red_social/BACK/rutas/rutas.php?id=$1 [L,QSA]

RewriteRule ^mensaje$ /red_social/BACK/rutas/rutas.php [L]
RewriteRule ^mensaje/([0-9]+)$ /red_social/BACK/rutas/rutas.php?id=$1 [L,QSA]

RewriteRule ^foto$ /red_social/BACK/rutas/rutas.php [L]
RewriteRule ^foto/([0-9]+)$ /red_social/BACK/rutas/rutas.php?id=$1 [L,QSA]
